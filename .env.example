# Copy to .env and replace the password before starting PostgreSQL.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=shopping_agent
PGUSER=shopping_agent
PGPASSWORD=replace-with-your-local-password
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
EMBEDDING_MODEL=BAAI/bge-m3

# Optional shared infrastructure; blank keeps local development mode
REDIS_URL=
EVALUATION_DB=data/evaluation.sqlite3
REDIS_PREFIX=shopping
SESSION_TTL_SECONDS=1800
RATE_LIMIT_PER_MINUTE=60
# Set only when a Collector is running; never required for local evaluation.
OTEL_EXPORTER_OTLP_ENDPOINT=
